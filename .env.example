# Firebase Realtime Database Environment Variables
# Configure these environment variables in Vercel Project Settings

NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=shinobi-seals.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://shinobi-seals-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=shinobi-seals
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=shinobi-seals.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abc123def456
